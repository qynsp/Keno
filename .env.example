# PORT: Port on which the application server listens (default: 3000)
PORT=3000

# NODE_ENV: Environment mode ('development' or 'production')
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI features (if used).
GEMINI_API_KEY=

# APP_URL: Public URL of your deployed application (e.g. https://your-app.aletcloud.com).
APP_URL=

# DATABASE_URL: Optional PostgreSQL database connection string.
# e.g., postgresql://postgres:password@localhost:5432/keno_db
# If not provided, the application automatically uses local file persistence (./data/keno_db.json).
DATABASE_URL=

# ADMIN_PASSWORD: Custom password for admin login (default: 'admin').
ADMIN_PASSWORD=

# JWT_SECRET: Secret key for signing authentication tokens.
JWT_SECRET=

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot token from @BotFather.
# Used if embedding or connecting a Telegram Mini App bot.
TELEGRAM_BOT_TOKEN=
